# Single-file runtime configuration for local/dev.
# Keep secrets out of git in production.

# Environment mode: dev | test | prod
APP_ENV=dev

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3002,http://127.0.0.1:3002,http://localhost:3000,http://127.0.0.1:3000

# HTTPS enforcement at app level (behind reverse proxy set to 1 on prod)
ENFORCE_HTTPS=0

# Disable automatic startup seed for slownik_pozycje entries.
DISABLE_SLOWNIK_POZYCJE_SEED=1

# Disable automatic startup seed for default teams A/B/C/D.
DISABLE_TEAMS_SEED=1

# Team lead dictionary write restrictions.
# Allowlist (if set): manager can edit/add only these dictionary types.
# Requested scope:
# - ogolne: department_ogolne
# - inspekcje: nazwy_podmiotow, zakresy_inspekcji
# - wnioski sankcyjne: department, podstawa_prawna_sankcji,
#   naruszenia_skutkujace_sankcja, nazwy_podmiotow_sankcje
MANAGER_SLOWNIKI_ALLOWED_TYPES=department_ogolne,nazwy_podmiotow,zakresy_inspekcji,department,podstawa_prawna_sankcji,naruszenia_skutkujace_sankcja,nazwy_podmiotow_sankcje
# Types list format: kod_typu,kod_typu2
MANAGER_SLOWNIKI_BLOCKED_TYPES=
# Specific items format: kod_typu:kod_pozycji,kod_typu2:kod_pozycji2
MANAGER_SLOWNIKI_BLOCKED_ITEMS=
# Slowniki DELETE endpoint rollout switch (1=true, 0=false)
SLOWNIKI_DELETE_ENABLED=1

# Role-based blocking of inspection statuses for link-with-inspection views
# and save operations in modules: Zalecenia and Wnioski sankcyjne.
# Format: comma/semicolon/newline-separated status kod_pozycji values (e.g. I_SI_10,I_SI_11).
# Role IDs: 1=inspektor, 2=kierownik, 3=dyrektor.
# KOD POZYCJI SLOWNIKA: tutaj wpisujesz recznie kody statusow inspekcji do ukrycia/blokady.
RECOMMENDATIONS_BLOCKED_INSPECTION_STATUS_CODES=I_SI_9,I_SI_10,I_SI_12,I_SI_13
RECOMMENDATIONS_BLOCKED_INSPECTION_STATUS_CODES_ROLE_1=I_SI_9,I_SI_10,I_SI_12,I_SI_13
RECOMMENDATIONS_BLOCKED_INSPECTION_STATUS_CODES_ROLE_2=I_SI_9,I_SI_10,I_SI_12,I_SI_13
RECOMMENDATIONS_BLOCKED_INSPECTION_STATUS_CODES_ROLE_3=I_SI_9,I_SI_10,I_SI_12,I_SI_13

RISK_EXPOSURE_BLOCKED_INSPECTION_STATUS_CODES=
RISK_EXPOSURE_BLOCKED_INSPECTION_STATUS_CODES_ROLE_1=
RISK_EXPOSURE_BLOCKED_INSPECTION_STATUS_CODES_ROLE_2=
RISK_EXPOSURE_BLOCKED_INSPECTION_STATUS_CODES_ROLE_3=

# Decyzje zobowiazujace (powiazanie z zaleceniami):
# KOD POZYCJI SLOWNIKA statusu zalecenia (np. Z_SZ_1), dla ktorego
# nie pokazujemy opcji powiazania z zaleceniem i blokujemy zapis przez API.
OBLIGATING_DECISIONS_BLOCKED_RECOMMENDATION_STATUS_CODES=
OBLIGATING_DECISIONS_BLOCKED_RECOMMENDATION_STATUS_CODES_ROLE_1=
OBLIGATING_DECISIONS_BLOCKED_RECOMMENDATION_STATUS_CODES_ROLE_2=
OBLIGATING_DECISIONS_BLOCKED_RECOMMENDATION_STATUS_CODES_ROLE_3=

# Dashboard: wykluczenia po kodach statusow (kod_pozycji).
# Format: comma/semicolon/newline-separated values, np. I_SI_10,I_SI_11
# WYLACZENIA INSPEKCJI (statusy_inspekcji.kod_pozycji)
DASHBOARD_EXCLUDED_INSPECTION_STATUS_CODES=I_SI_9,I_SI_10,I_SI_12,I_SI_13
# Kolejnosc statusow INSPEKCJI w podsumowaniu dashboardu (kod_pozycji).
# Najpierw pojawia sie lista zdefiniowana tutaj; statusy niewymienione beda po niej.
# Format: comma/semicolon/newline-separated values, np. I_SI_4,I_SI_5,I_SI_6
DASHBOARD_INSPECTION_STATUS_ORDER_CODES=I_SI_17
# WYLACZENIA ZALECEN (statusy_zalecen.kod_pozycji)
DASHBOARD_EXCLUDED_RECOMMENDATION_STATUS_CODES=
# Alert "czas" w dashboardzie: statusy inspekcji (kod_pozycji), dla ktorych liczymy bucket alertu.
# Domyslnie backend przyjmie I_SI_4, jesli to pole bedzie puste.
DASHBOARD_ALERT_INSPECTION_STATUS_CODES=I_SI_3

# Raporty API (/api/reports/*): wykluczenia po kodach statusow (kod_pozycji).
# WYLACZENIA INSPEKCJI (statusy_inspekcji.kod_pozycji)
REPORTS_EXCLUDED_INSPECTION_STATUS_CODES=
# WYLACZENIA ZALECEN (statusy_zalecen.kod_pozycji)
REPORTS_EXCLUDED_RECOMMENDATION_STATUS_CODES=
# Raport dashboardu: endpoint /api/reports/send-html dziala w trybie PDF-only.
# App-level limit dla calego request body (MB).
REPORTS_API_MAX_BODY_MB=80
# Walidacje startup dla raportow.
REPORTS_STARTUP_VALIDATE_SMTP=1
# Opcjonalna walidacja Playwright/Chromium przy starcie.
REPORTS_STARTUP_VALIDATE_PDF=0
# Gdy 1: bledy walidacji startup zatrzymuja aplikacje.
REPORTS_STARTUP_STRICT=0
# Retry/timeout SMTP dla endpointow raportowych.
REPORTS_SMTP_RETRY_ATTEMPTS=2
REPORTS_SMTP_TIMEOUT_SECONDS=30
# Maksymalny rozmiar calej wiadomosci e-mail (po MIME/base64), ograniczenie dla SMTP.
REPORTS_SMTP_MAX_MESSAGE_MB=24
# Gdy 1: odpowiedz API 5xx zawiera pelniejszy komunikat SMTP.
REPORTS_EMAIL_DEBUG_ERRORS=0

# Walidacja statusu inspekcji podczas zapisu (create/update) po kod_pozycji.
# Umozliwia mapowanie statusu na oczekiwania dot. powiazan:
# - recommendations (zalecenia)
# - risk_exposure_requests (wnioski sankcyjne)
# Preferowany format (1 status = 1 regula):
# CODE:R+,S- ; CODE:R-,S+ ; CODE:R+,S+
# Tokeny:
# - R+ wymagaj zalecen, R- zabron zalecen
# - S+ wymagaj wniosku sankcyjnego, S- zabron wniosku sankcyjnego
# Dla statusow zamknietych:
# - I_SI_9  (wydano zalecenia): R+,S-
# - I_SI_10 (brak zalecen i wniosku): R-,S-
# - I_SI_12 (sporzadzono wniosek): R-,S+
# - I_SI_13 (wydano zalecenia i sporzadzono wniosek): R+,S+
INSPECTIONS_STATUS_RELATION_RULES=I_SI_9:R+,S-;I_SI_10:R-,S-;I_SI_12:R-,S+;I_SI_13:R+,S+

# Legacy fallback format (pozostawione dla kompatybilnosci; gdy RELATION_RULES puste):
INSPECTIONS_STATUS_REQUIRES_RECOMMENDATIONS_CODES=
INSPECTIONS_STATUS_FORBIDS_RECOMMENDATIONS_CODES=
INSPECTIONS_STATUS_REQUIRES_SANCTIONS_CODES=
INSPECTIONS_STATUS_FORBIDS_SANCTIONS_CODES=

# Inspection scopes contract: when disabled, zakresInspekcji string is treated as one full value
# (no split by comma/semicolon). Prefer zakresInspekcjiIds or zakresInspekcjiList.
INSPECTIONS_LEGACY_SCOPE_TEXT_SPLIT_ENABLED=0

# Inspections filters: jawna klasyfikacja grup filtrowania po kodzie zespolu.
# Format: TEAM_CODE:GROUP,TEAM_CODE2:GROUP2 (GROUP: DYREKCJA|DIU|DNU)
# Przyklad: DYR:DYREKCJA,DIU_1:DIU,DNU_1:DNU
INSPECTIONS_TEAM_FILTER_GROUP_MAP=
# Domyslna grupa dla zespolow, ktore nie pasuja do mapy ani wzorcow nazw/kodow.
INSPECTIONS_TEAM_FILTER_GROUP_DEFAULT=DIU

# Auth session settings
AUTH_SESSION_TTL_HOURS=12
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOGIN_WINDOW_MINUTES=15
AUTH_LOCKOUT_MINUTES=15

# Invite flow settings
AUTH_INVITE_TTL_HOURS=24
FRONTEND_INVITE_URL=http://172.25.210.87:3002/set-password
AUTH_PASSWORD_RESET_TTL_MINUTES=60
AUTH_PASSWORD_RESET_MIN_INTERVAL_SECONDS=60
FRONTEND_RESET_PASSWORD_URL=http://172.25.210.87:3002/reset-password

# Invite delivery mode: log | smtp
# - log: do not send email, return inviteLink in API response
# - smtp: send real email using SMTP settings below
INVITE_EMAIL_MODE=smtp
# Optional schedule delivery mode override: log | smtp
# If empty, schedules use EMAIL_SEND_MODE, then INVITE_EMAIL_MODE.
SCHEDULE_EMAIL_MODE=smtp

# SMTP settings (used only when INVITE_EMAIL_MODE=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_LOGIN=mateusz.winiarski.komm@gmail.com
SMTP_PASS=zjzcojvjprupdrht

# Prefer storing SMTP password outside repo and pointing to it via SMTP_PASS_FILE.
SMTP_PASS_FILE=zjzcojvjprupdrht
SMTP_LOGIN_MAIL=mateusz.winiarski.komm@gmail.com
FROM_EMAIL=mateusz.winiarski.komm@gmail.com
INVITE_EMAIL_SUBJECT=Zaproszenie do ustawienia hasla
INVITE_EMAIL_TEMPLATE_FILE=config/invite_email_template.txt
RESET_PASSWORD_EMAIL_SUBJECT=Reset hasla
RESET_PASSWORD_EMAIL_TEMPLATE_FILE=config/reset_password_email_template.txt

# When moving to internal/company SMTP, change only these fields:
# SMTP_HOST=
# SMTP_PORT=
# SMTP_SECURITY=starttls|ssl|plain
# SMTP_LOGIN=
# SMTP_PASS=
# SMTP_LOGIN_MAIL=
# FROM_EMAIL=
